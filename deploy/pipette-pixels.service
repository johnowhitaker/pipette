[Unit]
Description=Pipette Pixels web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=johno
Group=johno
WorkingDirectory=/home/johno/pipette
EnvironmentFile=-/home/johno/pipette/.env
ExecStart=/home/johno/pipette/.venv/bin/uvicorn pixel_pipette.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

